[node name="FunFactBubble" type="Node2D"]
script = ExtResource("1_bubble")
facts = Array[String](["Leroy Anderson dreamed up \"Sleigh Ride\" during a July heat wave. No snow in sight.", "The Boston Pops premiered \"Sleigh Ride\" on May 4, 1948 - in the spring, not winter.", "\"Sleigh Ride\" had no words for two years. Mitchell Parish added lyrics in 1950.", "Leroy Anderson translated for U.S. Army intelligence in Iceland during WWII.", "Anderson also wrote \"The Typewriter,\" scored for an actual typewriter.", "\"Let It Snow!\" is a Thanksgiving weekend tradition at the Carpenter Theatre.", "About 200,000 people hear the Richmond Symphony live every year.", "One patron insists Anderson's \"Bugler's Holiday\" is a perfect holiday tune."])

